{
  "name": "@ourfairy/dsh-sessions",
  "version": "0.1.0",
  "private": true,
  "description": "OurFairy owned sessions: SessionHeader.owner as the only ownership authority, plus the identity's deterministic fixed primary session, with the product's own request paths.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "locale/*.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@ourfairy/dsh-http": "^0.1.0",
    "@ourfairy/dsh-identity": "^0.1.0"
  }
}
