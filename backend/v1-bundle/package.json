{
  "name": "@ourfairy/dsh-v1-bundle",
  "version": "0.1.0",
  "private": true,
  "description": "OurFairy v1 backend bundle: the explicit first-version row set, composed without inheriting @deepseek-ai/dsh-base.",
  "type": "module",
  "license": "UNLICENSED",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@ourfairy/dsh-identity": "file:../identity",
    "@ourfairy/dsh-sessions": "file:../sessions",
    "@ourfairy/dsh-chat": "file:../chat",
    "@ourfairy/dsh-gateway": "file:../gateway",
    "@ourfairy/dsh-speech": "file:../speech",
    "@ourfairy/dsh-search": "file:../search",
    "@ourfairy/dsh-attachments": "file:../attachments",
    "@ourfairy/dsh-spaces": "file:../spaces",
    "@ourfairy/dsh-groups": "file:../groups"
  },
  "exports": {
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "locale/*.json"
  ]
}
