{
  "name": "@ourfairy/dsh-spaces",
  "version": "0.1.0",
  "private": true,
  "description": "OurFairy owned file spaces and the scoped filesystem, sandbox, shell and working-directory providers.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "locale/*.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-fs": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-fs-local": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-bash-sandbox": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-alpha.2",
    "@ourfairy/dsh-identity": "^0.1.0",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./policy": {
      "types": "./dist/policy.d.ts",
      "default": "./dist/policy.js"
    },
    "./bwrap": {
      "types": "./dist/bwrap.d.ts",
      "default": "./dist/bwrap.js"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "default": "./dist/fs.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.ts",
      "default": "./dist/sandbox.js"
    },
    "./bash": {
      "types": "./dist/bash.d.ts",
      "default": "./dist/bash.js"
    },
    "./directory": {
      "types": "./dist/directory.d.ts",
      "default": "./dist/directory.js"
    }
  }
}
