{
  "name": "@ourfairy/dsh-baseline-probe",
  "version": "0.1.0",
  "private": true,
  "description": "Test-only liveness probe for the OurFairy v1 backend composition. Mounted through a --patch overlay and never part of the product bundle.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "overlay.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@ourfairy/dsh-identity": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@ourfairy/dsh-identity": {
      "optional": true
    }
  }
}
