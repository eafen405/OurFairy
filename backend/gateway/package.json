{
  "name": "@ourfairy/dsh-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "OurFairy's Phaethon-only shared-configuration gateway: provider routes, the shared model selection and the ASR connection, persisted through the native dsh profile settings.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "locale/*.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.1-alpha.2",
    "@ourfairy/dsh-http": "^0.1.0",
    "@ourfairy/dsh-memory": "^0.1.0"
  }
}
