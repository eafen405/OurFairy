{
  "name": "@ourfairy/dsh-speech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "default": "./dist/policy.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "locale/*.json"
  ],
  "peerDependencies": {
    "@ourfairy/dsh-http": "^0.1.0",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1"
  },
  "description": "OurFairy speech-to-text transcription of uploaded audio through the configured ASR route."
}
