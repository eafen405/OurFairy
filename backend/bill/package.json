{
  "name": "@ourfairy/dsh-bill",
  "version": "0.1.0",
  "private": true,
  "description": "OurFairy electricity bill: per-session token usage derived from the durable session logs, folded into local-day, month and all-time totals with a revision-keyed per-session cache.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fold": {
      "types": "./dist/fold.d.ts",
      "default": "./dist/fold.js"
    },
    "./aggregate": {
      "types": "./dist/aggregate.d.ts",
      "default": "./dist/aggregate.js"
    },
    "./reading": {
      "types": "./dist/reading.d.ts",
      "default": "./dist/reading.js"
    },
    "./previous": {
      "types": "./dist/previous.d.ts",
      "default": "./dist/previous.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "locale/*.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.2",
    "@ourfairy/dsh-identity": "^0.1.0",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-token-meter": "^0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1"
  }
}
