{
  "name": "@ourfairy/dsh-identity",
  "version": "0.1.0",
  "private": true,
  "description": "OurFairy identity module: users, short numbers, invites, and sessions in the business SQLite store, with its own /identity/* routes and session tokens that admit dsh /api.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    },
    "./owner": {
      "types": "./dist/owner.d.ts",
      "default": "./dist/owner.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "locale/*.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1",
    "@ourfairy/dsh-http": "^0.1.0"
  }
}
