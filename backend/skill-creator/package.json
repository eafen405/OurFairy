{
  "name": "@ourfairy/dsh-skill-creator",
  "version": "0.1.0",
  "private": true,
  "description": "OurFairy skill runtime: per-user skill providers, an immutable reviewed-version store, the read-only resource view, the native skill-activation surface and the deployment Skill Creator content.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "default": "./dist/seed.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "locale/*.json",
    "bundled/**/*"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill": "^0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1",
    "@ourfairy/dsh-http": "^0.1.0",
    "@ourfairy/dsh-identity": "^0.1.0",
    "@ourfairy/dsh-spaces": "^0.1.0"
  }
}
