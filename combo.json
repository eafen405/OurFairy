{
  "schemaVersion": 1,
  "product": "OurFairy v1",
  "repos": {
    "ourfairy": {
      "role": "product",
      "lock": "integration-branch",
      "localPath": "/home/eafen405/projects/OurFairy",
      "integrationBranch": "integration/ourfairy-v1"
    },
    "dsh": {
      "role": "backend-harness",
      "lock": "commit",
      "localPath": "/home/eafen405/projects/deepseek-harness",
      "remoteName": "fork",
      "remoteUrl": "https://github.com/eafen405/deepseek-harness.git",
      "integrationBranch": "product/ourfairy-v1",
      "productCommit": "5b8ec0f175d3d7ba0fc7f120165d5cad6fd81aaf",
      "requiredBuild": [
        "corepack pnpm@11.28.5 install",
        "corepack pnpm@11.28.5 run build:lib:host",
        "corepack pnpm@11.28.5 run build:lib:client",
        "corepack pnpm@11.28.5 run build:native-system"
      ],
      "note": "All four requiredBuild commands must run: build:lib:host builds the CLI and host libraries, build:lib:client emits the client-face Node loader entries the connection row imports, and build:native-system builds the flock addon the durable JSONL writer requires."
    }
  },
  "androidSource": {
    "role": "android-client",
    "commit": "460109d1b89b824a2ddb7f3201d8d3f7af7e02ce",
    "declaration": "android/ourfairy-source.json"
  },
  "backend": {
    "profileName": "ourfairy",
    "bundlePackage": "@ourfairy/dsh-v1-bundle",
    "bundlePathInRepo": "backend/v1-bundle",
    "probePackage": "@ourfairy/dsh-baseline-probe",
    "probePathInRepo": "backend/probe",
    "launcher": "scripts/ourfairy-backend.mjs",
    "nodeRange": "^22.19.0 || >=24",
    "pnpmPin": "11.28.5",
    "pnpmInvocation": "corepack pnpm@11.28.5"
  }
}
