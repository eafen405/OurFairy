{
  "name": "ourfairy",
  "version": "0.1.0",
  "private": true,
  "description": "OurFairy v1: an invited multi-user Fairy backend with an Android client. This repository holds the product modules, the explicit backend composition, and the version combination that binds the companion fork commits.",
  "type": "module",
  "license": "AGPL-3.0",
  "engines": {
    "node": "^22.19.0 || >=24.2.0"
  },
  "scripts": {
    "build": "node scripts/tsc.ts --fresh",
    "typecheck": "node scripts/tsc.ts",
    "clean": "node scripts/tsc.ts --clean",
    "pretest": "npm run build",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "specs:status": "node scripts/specs-status.ts",
    "evidence:index": "node scripts/evidence-index.ts",
    "bench:projection": "node scripts/bench-projection.ts",
    "bench:gate": "node scripts/bench-gate.ts",
    "combo:verify": "node scripts/combo.ts verify",
    "backend:probe": "node scripts/ourfairy-backend.ts probe",
    "backend:start": "node scripts/ourfairy-backend.ts start",
    "backend:stop": "node scripts/ourfairy-backend.ts stop",
    "backend:status": "node scripts/ourfairy-backend.ts status",
    "backend:doctor": "node scripts/ourfairy-backend.ts doctor",
    "hooks:install": "git config core.hooksPath .githooks"
  }
}
